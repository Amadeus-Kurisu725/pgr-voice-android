<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework><SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType><ApplicationId>cn.pgrvoice.touchsink</ApplicationId>
    <ApplicationTitle>独立触摸接收器</ApplicationTitle><ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>test-only</ApplicationDisplayVersion><RuntimeIdentifier>android-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AndroidPackageFormats>apk</AndroidPackageFormats><EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed><RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode><AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>
</Project>
