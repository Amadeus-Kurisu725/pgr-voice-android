<Project Sdk="Microsoft.NET.Sdk">
  <!-- 默认分支（第一/第二个选项）与“已核正文结束、出口未逐句核实”时沿包内登记返回连接续接的逻辑回归：
       听书（共享核心规划 + 安卓真实 ListeningSession 适配层）与游戏伴音（真实导航器 + DefaultBranchPolicy/DeclaredContinuationPolicy）。
       用法：dotnet run 后接 [第38章 pack.json] [results.json] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../core/PgrVoice.Core.csproj" />
    <Compile Include="Program.cs.txt;Stub.cs.txt" />
    <Compile Include="../../ListeningSession.cs;../../Contracts/IChapterStorage.cs;../../Contracts/IAudioOutput.cs;../../DefaultBranchPolicy.cs;../../DeclaredContinuationPolicy.cs;../../BranchFollowPolicy.cs;../../Ocr/OcrTypes.cs;../../AutoPlaybackCycle.cs" LinkBase="Production" />
  </ItemGroup>
</Project>
